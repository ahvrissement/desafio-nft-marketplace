# Copie para .env.local se quiser mudar algo. Sem nenhum arquivo .env, o padrão já funciona.

# Camada de mocks (MSW + Socket.IO simulado).
#   qualquer valor diferente de "false" (ou ausente) → mocks ligados (padrão, inclusive no deploy)
#   false → o app chama uma API real em /api (que este repositório não inclui)
VITE_ENABLE_MOCKS=true
